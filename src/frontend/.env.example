# ===========================================
# ClimaX Frontend - Environment Variables
# ===========================================

# API Configuration
VITE_API_URL=http://localhost:8081/api

# Development Configuration
VITE_APP_TITLE=ClimaX
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# API Configuration
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1
VITE_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# Application Configuration
VITE_APP_NAME=ClimaX
VITE_APP_DESCRIPTION=Get accurate weather forecasts with ClimaX. Real-time weather data, extended forecasts, and detailed weather information for any location worldwide.
VITE_APP_VERSION=1.0.0

# Default Settings
VITE_DEFAULT_CITY=New York
VITE_DEFAULT_FORECAST_DAYS=5
VITE_DEFAULT_TEMPERATURE_UNIT=celsius

# Feature Flags (true/false)
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_AUTOCOMPLETE=true
VITE_ENABLE_GEOLOCATION=true
VITE_ENABLE_FILTERS=true

# API Rate Limiting (requests per minute)
VITE_API_RATE_LIMIT=60

# Cache Configuration (in minutes)
VITE_CACHE_DURATION=10
