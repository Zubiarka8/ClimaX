# API Configuration
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1
VITE_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# Application Configuration
VITE_APP_NAME=ClimaX
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_CITY=New York
VITE_DEFAULT_FORECAST_DAYS=5

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_AUTOCOMPLETE=true
VITE_ENABLE_GEOLOCATION=true

# API Configuration
VITE_API_RATE_LIMIT=60
VITE_CACHE_DURATION=10
